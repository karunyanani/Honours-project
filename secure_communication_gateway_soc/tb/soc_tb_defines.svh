`ifndef SOC_TB_DEFINES_SVH
`define SOC_TB_DEFINES_SVH


// Bus parameters
parameter int AXI_DW  = 32;
parameter int AXI_AW  = 32;
parameter int AXI_IDW = 8;

// Slave base addresses
parameter logic [31:0] IMEM_BASE = 32'h00000000;
parameter logic [31:0] DMEM_BASE = 32'h00010000;
parameter logic [31:0] UART_BASE = 32'h10000000;
parameter logic [31:0] TIMER_BASE = 32'h10000100;
parameter logic [31:0] GPIO_BASE = 32'h10000200;
parameter logic [31:0] AES_BASE = 32'h10000300;
parameter logic [31:0] DMA_BASE = 32'h10000400;
parameter logic [31:0] SPI_BASE = 32'h10000500;
parameter logic [31:0] WDT_BASE = 32'h10000600;

// Slave sizes
parameter int IMEM_SIZE = 65536;
parameter int DMEM_SIZE = 65536;
parameter int UART_SIZE = 256;
parameter int TIMER_SIZE = 256;
parameter int GPIO_SIZE = 256;
parameter int AES_SIZE = 256;
parameter int DMA_SIZE = 256;
parameter int SPI_SIZE = 256;
parameter int WDT_SIZE = 256;

// Access control: 1=allowed, 0=denied (index = master index)
parameter logic [1:0] CONN_IMEM = 2'b01;
parameter logic [1:0] CONN_DMEM = 2'b11;
parameter logic [1:0] CONN_UART = 2'b11;
parameter logic [1:0] CONN_TIMER = 2'b01;
parameter logic [1:0] CONN_GPIO = 2'b01;
parameter logic [1:0] CONN_AES = 2'b11;
parameter logic [1:0] CONN_DMA = 2'b01;
parameter logic [1:0] CONN_SPI = 2'b11;
parameter logic [1:0] CONN_WDT = 2'b01;

// =========================================================================
// Register offsets (byte offset from slave base)
// =========================================================================

// UART
`define TB_UART_TX_DATA    8'h00
`define TB_UART_STATUS     8'h08
`define TB_UART_BAUD_DIV   8'h0C
`define TB_UART_CTRL       8'h10

// AES
`define TB_AES_KEY0        8'h00
`define TB_AES_KEY1        8'h04
`define TB_AES_KEY2        8'h08
`define TB_AES_KEY3        8'h0C
`define TB_AES_CTRL        8'h10
`define TB_AES_STATUS      8'h14
`define TB_AES_DATA_IN0    8'h18
`define TB_AES_DATA_IN1    8'h1C
`define TB_AES_DATA_IN2    8'h20
`define TB_AES_DATA_IN3    8'h24
`define TB_AES_DATA_OUT0   8'h28
`define TB_AES_DATA_OUT1   8'h2C
`define TB_AES_DATA_OUT2   8'h30
`define TB_AES_DATA_OUT3   8'h34

// DMA
`define TB_DMA_SRC_ADDR    8'h00
`define TB_DMA_DST_ADDR    8'h04
`define TB_DMA_LEN         8'h08
`define TB_DMA_CTRL        8'h0C
`define TB_DMA_STATUS      8'h10

// Watchdog
`define TB_WDT_FEED        8'h00
`define TB_WDT_TIMEOUT     8'h04
`define TB_WDT_CTRL        8'h08
`define TB_WDT_RESET_CAUSE 8'h0C
`define TB_WDT_MAGIC       32'hDEAD_FEED

// SPI
`define TB_SPI_RX_DATA     8'h04
`define TB_SPI_STATUS      8'h08
`define TB_SPI_CTRL        8'h0C

// AXI response codes
`define AXI_RESP_OKAY    2'b00
`define AXI_RESP_EXOKAY  2'b01
`define AXI_RESP_SLVERR  2'b10
`define AXI_RESP_DECERR  2'b11

`endif // SOC_TB_DEFINES_SVH
