`define AES_ADDR_W  32'd8
`define DMA_ADDR_W  32'd8
`define SPI_ADDR_W  32'd8
`define WDT_ADDR_W  32'd8

// Access-control connectivity masks
// Bit 0 = master 0 (CPU), bit 1 = master 1 (DMA)
`define CONN_IMEM    2'b01
`define CONN_DMEM    2'b11
`define CONN_UART    2'b11
`define CONN_TIMER   2'b01
`define CONN_GPIO    2'b01
`define CONN_AES     2'b11
